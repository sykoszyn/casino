PORT=4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
LOG_LEVEL=silent

# API oficial de WhatsApp (Meta Cloud API) — solo hace falta si vas a usar líneas
# con connection_type = 'cloud_api'. Las líneas por QR/código no la necesitan.
# WHATSAPP_CLOUD_VERIFY_TOKEN: inventalo vos (cualquier string random) y pegalo también
#   en developers.facebook.com > tu app > WhatsApp > Configuración > Webhooks, al configurar
#   la URL de callback como https://<tu-backend>/webhook/whatsapp-cloud
# WHATSAPP_APP_SECRET: developers.facebook.com > tu app > Configuración básica > Clave secreta de la app.
#   Sin esto, cualquiera que sepa la URL del webhook podría mandar mensajes falsos al CRM.
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
